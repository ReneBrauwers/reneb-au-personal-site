@page "/privacy"
@model ReneB.Portal.Pages.PrivacyModel
@{ ViewData["Title"] = "Recruiter portal privacy notice"; }
<section class="content-section">
  <div class="portal-shell section-grid">
    <div>
      <p class="section-eyebrow">@Model.Notice.Eyebrow</p>
      <h1>@Model.Notice.Heading</h1>
    </div>
    <div class="prose-stack">
      <h2>What is collected</h2>
      @Html.Raw(Model.Html(Model.Notice.WhatIsCollected))

      <h2>Why it is collected</h2>
      @Html.Raw(Model.Html(Model.Notice.WhyItIsCollected))

      <h2>How it is handled</h2>
      @Html.Raw(Model.Html(Model.Notice.HowItIsHandled))

      <h2>Access, retention and deletion</h2>
      @Html.Raw(Model.Html(Model.Notice.AccessRetentionDeletion))

      <h2>Your choice</h2>
      @Html.Raw(Model.Html(Model.Notice.YourChoice))
      <p class="field-hint">Last reviewed @Model.Notice.LastReviewed.ToString("dd MMMM yyyy").</p>
      <p><a class="button button-secondary" href="/auth/register">Return to access request</a></p>
    </div>
  </div>
</section>
