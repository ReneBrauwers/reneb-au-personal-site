@page "/admin"
@model ReneB.Portal.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Portal administration";
}
<section class="content-section"><div class="portal-shell">
  <p class="section-eyebrow">Administrator</p>
  <h1>Recruiter portal control centre.</h1>
  <div class="admin-grid">
    <a class="evidence-card" href="/admin/content"><h2>Content studio</h2><p>Edit homepage, global settings and Umami, recruiter discovery, opportunity terms, privacy and machine guidance with drafts, previews and history.</p></a>
    <a class="evidence-card" href="/admin/ai"><h2>AI authoring</h2><p>Use a configured OpenRouter or xAI model to create governed draft proposals from explicitly selected context.</p></a>
    <a class="evidence-card" href="/admin/content/recruiter-profile"><h2>Public discovery profile</h2><p>Edit, preview and atomically publish the HTML, JSON-LD, Markdown, JSON and llms.txt source record.</p></a>
    <a class="evidence-card" href="/admin/content/opportunity-profile"><h2>Private opportunity terms</h2><p>Maintain detailed interests, compensation, availability and matching guidance.</p></a>
    <a class="evidence-card" href="/admin/recruiters"><h2>Recruiters and grants</h2><p>Approve risk-flagged accounts and manage 30-day résumé grants.</p></a>
    <a class="evidence-card" href="/admin/messages"><h2>Private inbox</h2><p>Read and delete messages stored in the encrypted portal database.</p></a>
    <a class="evidence-card" href="/admin/resume"><h2>Résumé</h2><p>Validate and publish the current PDF while retaining one rollback version.</p></a>
  </div>
</div></section>
