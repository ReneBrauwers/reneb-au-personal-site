@page "/admin/ai/context"
@model ReneB.Portal.Pages.Admin.Ai.ContextModel
@{ViewData["Title"]="AI context library";}
<section class="content-section"><div class="portal-shell"><p class="section-eyebrow">Encrypted local context</p><h1>Context library.</h1><p>PDF, DOCX, TXT and Markdown are validated and extracted locally. Providers receive only selected extracted text during an acknowledged request—never the original file.</p>
@if(TempData["Status"] is string status){<div class="notice notice-success"><p>@status</p></div>}<div asp-validation-summary="All"></div>
<form method="post" enctype="multipart/form-data" class="form-card"><div class="field"><label asp-for="Upload">Context document</label><input asp-for="Upload" type="file" accept=".pdf,.docx,.txt,.md,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown"></div><button class="button" type="submit">Validate and store</button></form>
<p>@Model.Assets.Count documents · @((Model.TotalBytes/1024d/1024d).ToString("0.00")) MB of 50 MB.</p><div class="table-wrap"><table><thead><tr><th>Document</th><th>Type</th><th>Size</th><th>Added</th><th>Action</th></tr></thead><tbody>@foreach(var asset in Model.Assets){<tr><td>@asset.FileName</td><td>@asset.MediaType</td><td>@((asset.Size/1024d).ToString("0.0")) KB</td><td>@asset.CreatedAt.ToString("dd MMM yyyy HH:mm 'UTC'")</td><td><form method="post" asp-page-handler="Delete"><input type="hidden" name="id" value="@asset.Id"><button class="button button-secondary" type="submit">Delete</button></form></td></tr>}</tbody></table></div><p><a class="button button-secondary" href="/admin/ai">AI authoring</a> <a class="button button-secondary" href="/admin/ai/providers">Provider settings</a></p>
</div></section>
