@page "/admin/ai"
@model ReneB.Portal.Pages.Admin.Ai.IndexModel
@{ViewData["Title"]="AI content authoring";}
<section class="content-section"><div class="portal-shell"><p class="section-eyebrow">Human-reviewed authoring</p><h1>Talk through the content. Apply a draft.</h1><p>The model can produce a schema-valid draft proposal. It cannot publish, use tools, browse, contact recruiters or see unselected private information.</p>
@if(!Model.EgressEnabled){<div class="notice notice-warning"><p>AI egress is disabled by the host. Enable it only after provider configuration and privacy review.</p></div>} @if(TempData["Status"] is string status){<div class="notice notice-success"><p>@status</p></div>}<div asp-validation-summary="All"></div>
<div class="section-grid ai-authoring-grid"><div><form method="post" asp-page-handler="Propose" class="form-card"><input asp-for="ConversationId" type="hidden"><div class="field"><label asp-for="Provider">Provider</label><select asp-for="Provider"><option value="">Select a tested provider</option>@foreach(var provider in Model.Providers){<option value="@provider.Provider">@provider.Provider · @provider.SelectedModel</option>}</select></div><div class="field"><label asp-for="DocumentKey">Target content</label><select asp-for="DocumentKey">@foreach(var key in ContentDocumentKeys.All){<option value="@key">@key</option>}</select></div><div class="field"><label asp-for="AuthoringRequest">What should change?</label><textarea asp-for="AuthoringRequest" minlength="10"></textarea></div><div class="field"><label><input asp-for="IncludePublishedContent"><span>Include the current published target as public context</span></label></div><div class="field"><label><input asp-for="IncludePrivateOpportunity"><span>Include the encrypted private opportunity profile</span></label></div><div class="field"><label><input asp-for="IncludeResume" disabled="@(!Model.ResumeAvailable)"><span>Include the active résumé as extracted private context @if(!Model.ResumeAvailable){<span class="field-hint">(no active résumé)</span>}</span></label></div>
<fieldset><legend>Additional encrypted context</legend>@if(Model.Assets.Count==0){<p class="field-hint">No reusable context is uploaded. Add documents in the <a href="/admin/ai/context">context library</a>.</p>}else{@foreach(var asset in Model.Assets){<div class="field"><label><input type="checkbox" name="ContextIds" value="@asset.Id" checked="@Model.ContextIds.Contains(asset.Id)"> @asset.FileName</label></div>}}</fieldset>
<div class="notice notice-warning"><p>Selected uploads and the private opportunity profile will be sent as extracted text to the chosen third-party provider. xAI retains inputs/outputs for 30 days unless its team has ZDR enabled; OpenRouter routes only through endpoints that deny data collection for these requests. The observed ZDR header is recorded, but provider policy remains external.</p><div class="field"><label><input asp-for="PrivateDisclosureAcknowledged"> I explicitly approve sending the selected private sources to this provider/model for this request.</label></div></div><button class="button" type="submit" disabled="@(!Model.EgressEnabled||Model.Providers.Count==0)">Propose draft changes</button></form></div>
<div><h2>Conversation</h2>@if(Model.Messages.Count==0){<p>No messages in this conversation.</p>}else{@foreach(var message in Model.Messages){<article class="evidence-card"><p class="section-eyebrow">@message.Role</p><p class="pre-line">@message.Body</p></article>}}
@if(Model.Proposal is not null){<article class="form-card"><p class="section-eyebrow">Draft proposal</p><h2>@Model.Proposal.Summary</h2><p>Base revision @Model.Proposal.BaseRevision · @Model.Proposal.Status</p>@if(Model.Proposal.Status==AiProposalStatus.Proposed){<form method="post" asp-page-handler="Apply"><input type="hidden" name="proposalId" value="@Model.Proposal.Id"><button class="button" type="submit">Validate and apply to draft</button></form>}<details><summary>Proposed structured content</summary><pre>@Model.Proposal.ProposedContentJson</pre></details></article>}</div></div>
<h2>Recent conversations</h2><div class="table-wrap"><table><thead><tr><th>Target</th><th>Provider/model</th><th>Last active</th><th>Actions</th></tr></thead><tbody>@foreach(var conversation in Model.Conversations){<tr><td>@conversation.DocumentKey</td><td>@conversation.Provider · @conversation.ModelId</td><td>@conversation.LastActiveAt.ToString("dd MMM yyyy HH:mm 'UTC'")</td><td><div class="stack-actions"><a class="button button-secondary" href="/admin/ai?conversationId=@conversation.Id">Open</a><form method="post" asp-page-handler="Delete"><input type="hidden" name="conversationId" value="@conversation.Id"><button class="button button-secondary" type="submit">Delete</button></form></div></td></tr>}</tbody></table></div><p><a class="button button-secondary" href="/admin/ai/providers">Provider settings</a> <a class="button button-secondary" href="/admin/ai/context">Context library</a></p>
</div></section>
