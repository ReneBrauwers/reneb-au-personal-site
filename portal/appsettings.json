{
  "Portal": {
    "Enabled": false,
    "DataDirectory": "/app/data",
    "BackupDirectory": "/app/backups",
    "CanonicalBaseUrl": "https://reneb.au",
    "AdminEmails": [],
    "TrustedBusinessDomains": []
  },
  "Encryption": {
    "KeyFile": "/run/secrets/field-encryption-keyring.json",
    "AllowDevelopmentKey": false
  },
  "Mail": {
    "Mode": "Graph",
    "TenantId": "",
    "ClientId": "",
    "SenderMailbox": "",
    "CertificatePath": "/run/secrets/graph-mail-certificate.pem",
    "PrivateKeyPath": "/run/secrets/graph-mail-private-key.pem"
  },
  "CookieKeyProtection": {
    "CertificatePath": "/run/secrets/data-protection-certificate.pem",
    "PrivateKeyPath": "/run/secrets/data-protection-private-key.pem"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Data.Sqlite": "Warning"
    }
  },
  "AllowedHosts": "reneb.au;localhost;127.0.0.1;portal"
}
