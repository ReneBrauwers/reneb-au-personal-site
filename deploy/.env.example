# The default tracks the newest successful build from main.
# Override with a sha-* tag or digest for an intentional pin or rollback.
RENEB_AU_IMAGE=ghcr.io/renebrauwers/reneb-au-personal-site:latest
RENEB_AU_PORTAL_IMAGE=ghcr.io/renebrauwers/reneb-au-recruiter-portal:latest

# Keep false until database migration, M365 delivery, administrator TOTP,
# public/private profile setup and résumé upload have passed acceptance.
RECRUITER_PORTAL_ENABLED=false
ADMIN_EMAILS=admin@example.invalid
UNTRUSTED_EMAIL_DOMAINS=126.com,163.com,aol.com,fastmail.com,gmail.com,googlemail.com,gmx.com,gmx.net,hey.com,hotmail.com,hushmail.com,icloud.com,live.com,mail.com,mail.ru,me.com,msn.com,outlook.com,pm.me,proton.me,protonmail.com,qq.com,rocketmail.com,tuta.com,tutanota.com,yahoo.com,yahoo.com.au,yandex.com,yandex.ru,zoho.com
DISPOSABLE_EMAIL_DOMAINS=10minutemail.com,dispostable.com,emailondeck.com,fakemail.net,getnada.com,grr.la,guerrillamail.biz,guerrillamail.com,guerrillamail.de,guerrillamail.info,guerrillamailblock.com,maildrop.cc,mailinator.com,minuteinbox.com,moakt.com,mytemp.email,sharklasers.com,temp-mail.io,temp-mail.org,tempail.com,tempmail.com,throwawaymail.com,trashmail.com,yopmail.com
PORTAL_TRUSTED_PROXY_NETWORKS=172.30.0.0/16,192.0.2.0/28

MAIL_TENANT_ID=00000000-0000-0000-0000-000000000000
MAIL_CLIENT_ID=00000000-0000-0000-0000-000000000000
MAIL_SENDER_MAILBOX=recruiter-access@example.invalid

# Absolute host paths. The files remain outside the repository and .env.
PORTAL_KEYRING_FILE=/srv/secrets/reneb-au/field-encryption-keyring.json
GRAPH_MAIL_CERTIFICATE_FILE=/srv/secrets/reneb-au/graph-mail-certificate.pem
GRAPH_MAIL_PRIVATE_KEY_FILE=/srv/secrets/reneb-au/graph-mail-private-key.pem
DATA_PROTECTION_CERTIFICATE_FILE=/srv/secrets/reneb-au/data-protection-certificate.pem
DATA_PROTECTION_PRIVATE_KEY_FILE=/srv/secrets/reneb-au/data-protection-private-key.pem

SITE_BIND_ADDRESS=192.0.2.10
SITE_PORT=8091
